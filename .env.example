# Copy to .env and fill in. .env is never committed.

# Database: SQLite file (enough for one server) or Postgres later
DATABASE_URL=file:./platform.db
# Long random string; changing it logs everyone out of the admin
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Domains. Dev: horoshiy.localhost:3000 (regions: krd.horoshiy.localhost:3000). Must differ from the server's own host.
# Production: хорошийдом.рф — Cyrillic or punycode (xn--d1ahdngadl7b7a.xn--p1ai), the site converts it (DEPLOY.md).
NEXT_PUBLIC_ROOT_DOMAIN=horoshiy.localhost:3000
# subdomain (krd.домен.ru) or path (домен.ru/r/krd) — decided with the SEO specialist
NEXT_PUBLIC_REGION_MODE=subdomain
# 1 = open the site to search engines (only at launch)
NEXT_PUBLIC_INDEX=0
# --- Analytics (set before `npm run build`; empty = nothing loads). Goals: lead_submit, phone_click, messenger_click
# Yandex Metrika counter id
NEXT_PUBLIC_YM_ID=
# VK Ads (Top.Mail.Ru) counter id, and the script address from the pixel code in the VK Ads cabinet if it differs
NEXT_PUBLIC_VK_PIXEL_ID=
NEXT_PUBLIC_VK_PIXEL_SRC=

# --- Leads → Telegram. Token: @BotFather → /newbot. Chat id: add the bot to the managers' chat, send any message,
# open https://api.telegram.org/bot<TOKEN>/getUpdates — "chat":{"id":-100…}. Put it in the admin: Регионы → «Telegram для заявок».
TELEGRAM_BOT_TOKEN=
# 0 = the message has no name and phone, only a link to the lead in the admin (Telegram is a foreign service: 152-ФЗ, ask the lawyer)
TELEGRAM_PERSONAL_DATA=

# --- Leads → amoCRM. In the client's amoCRM: Настройки → Интеграции → «Создать интеграцию» → «Ключи и доступы» →
# долгосрочный токен. Empty = off (leads stay in the admin and Telegram). Unsent leads are retried every 5 minutes.
AMO_DOMAIN=
AMO_TOKEN=
# the funnel and its first stage for site leads (ids from the funnel URL in amoCRM); empty = the main funnel
AMO_PIPELINE_ID=
AMO_STATUS_ID=

# First admin created by `npm run seed` (password is generated if empty)
SEED_ADMIN_EMAIL=admin@horoshiy-dom.local
SEED_ADMIN_PASSWORD=

# Copy to .env and fill in. .env is never committed.

# Database: SQLite file (enough for one server) or Postgres later
DATABASE_URL=file:./platform.db
# Long random string; changing it logs everyone out of the admin
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Domains. Dev: horoshiy.localhost:3000 (regions: krd.horoshiy.localhost:3000). Must differ from the server's own host.
NEXT_PUBLIC_ROOT_DOMAIN=horoshiy.localhost:3000
# subdomain (krd.домен.ru) or path (домен.ru/r/krd) — decided with the SEO specialist
NEXT_PUBLIC_REGION_MODE=subdomain
# 1 = open the site to search engines (only at launch)
NEXT_PUBLIC_INDEX=0
# Yandex Metrika counter id (empty = no counter)
NEXT_PUBLIC_YM_ID=

# Leads → Telegram: bot token from @BotFather; chat ids are set per region in the admin
TELEGRAM_BOT_TOKEN=

# First admin created by `npm run seed` (password is generated if empty)
SEED_ADMIN_EMAIL=admin@horoshiy-dom.local
SEED_ADMIN_PASSWORD=
